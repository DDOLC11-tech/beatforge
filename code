    expandPattern([false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false]),
    expandPattern([true,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false]),
    expandPattern([false,false,false,false,false,false,false,true,false,false,false,false,false,false,false,true]),
  ],
  'House': [
    expandPattern([true,false,false,false,true,false,false,false,true,false,false,false,true,false,false,false]),
