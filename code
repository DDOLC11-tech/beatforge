import { useState, useCallback, useRef, useEffect } from 'react';
import { toast } from 'sonner';
import { StepGrid } from '@/components/StepGrid';
import { TransportControls } from '@/components/TransportControls';
import { SavedBeats } from '@/components/SavedBeats';
import { DEFAULT_TRACKS, STEP_COUNT, playSound, saveBeat, getSavedBeats, Beat, Track } from '@/lib/audioEngine';
import { Disc3, Sparkles } from 'lucide-react';

function deepCloneTracks(tracks: Track[]): Track[] {
  return tracks.map(t => ({ ...t, steps: [...t.steps] }));
}

// Pad or trim preset patterns to match STEP_COUNT (32 steps — repeat the 16-step pattern)
function expandPattern(p: boolean[]): boolean[] {
  const out = Array(STEP_COUNT).fill(false);
  for (let i = 0; i < STEP_COUNT; i++) out[i] = p[i % p.length];
  return out;
}

